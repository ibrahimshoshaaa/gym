DATABASE_URL=postgresql://postgres:password@localhost:5432/gym
PORT=3000
NODE_ENV=production
# Only set these to create the FIRST system owner; there is no default password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=System owner
# Optional comma-separated web origins. Native Flutter does not use CORS.
CORS_ORIGINS=
# Public gym registration creates a 14-day trial, never a system owner.
ALLOW_SIGNUP=true
