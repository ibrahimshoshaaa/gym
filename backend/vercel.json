{
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "src/schema.sql"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index?__route=$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 2 * * *"
    }
  ]
}
